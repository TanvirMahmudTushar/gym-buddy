# Copy this file to backend/.env for local development. It holds placeholders only: never put real values here.
# backend/.env is ignored by git, and the backend reads it on a developer machine only (never on Vercel, where these
# are set under Project -> Settings -> Environment Variables).

# Supabase transaction pooler URI (port 6543). Leave empty to use a local SQLite file, backend/gym_buddy.db.
DATABASE_URL=

# Signs the access tokens: at least 32 bytes, generated with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder is too short on purpose: locally the backend then uses a temporary secret, and on Vercel it refuses
# to start, so a copied placeholder can never become a real secret.
JWT_SECRET=change-me

# Mixed into every password before hashing: at least 32 bytes, generated the same way. Never change it once set:
# every password made with it would stop working. Too short here on purpose, like JWT_SECRET.
PASSWORD_PEPPER=change-me

# The browser origin allowed to call the API from another origin (CORS), exact and without a trailing slash, never *.
# Several may be separated by commas. On Vercel the deployed frontend is always allowed, so it can be left out there.
FRONTEND_ORIGIN=http://localhost:5173
